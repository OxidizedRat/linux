&qupv3_id_1 {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8650/Oneplus/caihong/adsp.mbn",
			"qcom/sm8650/Oneplus/caihong/adsp_dtb.mbn";

	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm8650/Oneplus/caihong/cdsp.mbn",
			"qcom/sm8650/Oneplus/caihong/cdsp_dtb.mbn";

