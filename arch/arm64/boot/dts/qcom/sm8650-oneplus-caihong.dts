 * DisplayPort over USB-C kept disabled for now; not needed for the DSI
 * panel.
&mdss_dp0 {
	status = "okay";
};

&mdss_dp0_out {
	status = "okay";
	data-lanes = <0 1>;
};
*/

&pcie0 {
	/*
	 * MSIs written by the endpoint never reach the GIC ITS on this board
	 * (the root port's own MSIs do), so use the controller's internal
	 * MSI instead.
	 */
	/delete-property/ msi-map;
	/delete-property/ msi-map-mask;

	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
	perst-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcieport0 {
	wifi@0 {
		compatible = "pci17cb,1107";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1i_0p88>;
	vdda-pll-supply = <&vreg_l3i_1p2>;

	status = "okay";
};

&pm8550_gpios {
	/* Thermistors read through the ADC: battery connector, SuperVOOC MOS */
	pm8550_therm_adc_default: therm-adc-default-state {
		pins = "gpio4", "gpio12";
		function = "normal";
		bias-high-impedance;
		bias-disable;
	};

	volume_up_n: volume-up-n-state {
		pins = "gpio6";
		function = "normal";
		bias-pull-up;
		input-enable;
		power-source = <1>;
	};
};

&pm8550b_eusb2_repeater {
	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;
};

&pm8550b_gpios {
	/*
	 * Thermistors read through the ADC: USB port left/right and sub-board.
	 * Left in their reset state (input, 10 uA pull-down) they read ~60 C.
	 */
	pm8550b_therm_adc_default: therm-adc-default-state {
		pins = "gpio5", "gpio6", "gpio10";
		function = "normal";
		bias-high-impedance;
		bias-disable;
	};
};

&pmk8550 {
	pmk8550_adc: adc@9000 {
		compatible = "qcom,spmi-adc5-gen3";
		reg = <0x9000>, <0x9100>;
		interrupts = <0x0 0x90 0x1 IRQ_TYPE_EDGE_RISING>,
			     <0x0 0x91 0x1 IRQ_TYPE_EDGE_RISING>;
		#address-cells = <1>;
		#size-cells = <0>;
		#io-channel-cells = <1>;
		#thermal-sensor-cells = <1>;

		pinctrl-0 = <&pm8550_therm_adc_default>, <&pm8550b_therm_adc_default>;
		pinctrl-names = "default";

		channel@3 {
			reg = <0x3>;
			label = "pmk8550_die_temp";
			qcom,pre-scaling = <1 1>;
		};

		channel@44 {
			reg = <0x44>;
			label = "pmk8550_xo_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@144 {
			reg = <0x144>;
			label = "pm8550_msm_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@145 {
			reg = <0x145>;
			label = "pm8550_cam_flash_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@146 {
			reg = <0x146>;
			label = "pm8550_wlan_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@147 {
			reg = <0x147>;
			label = "pm8550_pa_therm_1";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@148 {
			reg = <0x148>;
			label = "pm8550_rear_tof_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@14a {
			reg = <0x14a>;
			label = "pm8550_pa_therm_2";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@14b {
			reg = <0x14b>;
			label = "batt_con_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@14d {
			reg = <0x14d>;
			label = "svooc_mos_btb_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@703 {
			reg = <0x703>;
			label = "pm8550b_die_temp";
			qcom,pre-scaling = <1 1>;
		};

		channel@744 {
			reg = <0x744>;
			label = "pm8550b_batt_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@747 {
			reg = <0x747>;
			label = "usb_con_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@749 {
			reg = <0x749>;
			label = "usb_temp_r";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@74b {
			reg = <0x74b>;
			label = "usb_temp_l";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@74c {
			reg = <0x74c>;
			label = "subboard_therm";
			qcom,pre-scaling = <1 1>;
			qcom,ratiometric;
			qcom,hw-settle-time = <200>;
		};

		channel@78e {
			reg = <0x78e>;
			label = "pm8550b_vph_pwr";
			qcom,pre-scaling = <1 3>;
		};

		channel@78f {
			reg = <0x78f>;
			label = "pm8550b_vbat_sns_qbg";
			qcom,pre-scaling = <1 3>;
		};
	};
};

